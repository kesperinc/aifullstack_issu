# =================================================================
# Enterprise Coding Agent OS - Environment Variables Example Template
# =================================================================
# 다른 PC나 작업용 워크스테이션으로 복제/동기화 시 본 파일을 참조하여
# 로컬 전용 `.env` 파일을 복사 생성 후 사용할 실제 키를 입력하세요.
# (본 `.env.example` 파일에는 실제 계정, 암호, API Key를 포함하지 마세요)

# 1. LLM Provider 설정 (openrouter | rhoai_vllm | local_ollama)
LLM_PROVIDER=openrouter

# 2. OpenRouter API 설정 (Cloud Development Stage)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=qwen/qwen-2.5-coder-32b-instruct

# 3. Red Hat OpenShift AI (SNO) 온프레미스 vLLM 엔드포인트 (Stage 3 Target)
RHOAI_VLLM_ENDPOINT_URL=http://qwen-coder.rhoai.svc:8000/v1
RHOAI_VLLM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct

# 4. MCP Gateway Router 설정
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=3000

# 5. 개발자 워크스페이스 & 샌드박스 설정
SANDBOX_EXECUTION_TIMEOUT=30
ENABLE_SELF_CORRECTION=true
MAX_CORRECTION_ATTEMPTS=3

# 6. 보안 및 시크릿 스캐닝
ENABLE_SECRET_MASKING=true
